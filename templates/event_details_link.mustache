{{!
  @template mod_googlemeet/event_details_link

  Teacher-only button that opens the activity's Google Calendar event in a new tab.

  Context variables required for this template:
  * url - the Google Calendar event edit URL

  Example context (json):
  {
    "url": "https://calendar.google.com/calendar/u/0/r/eventedit/abc123"
  }
}}
<a class="btn btn-outline-primary ms-2" target="_blank" title="{{#cleanstr}} eventdetails, mod_googlemeet {{/cleanstr}}" href="{{url}}">{{#str}} eventdetails, mod_googlemeet {{/str}}</a>
