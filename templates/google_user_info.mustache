{{!
  @template mod_googlemeet/google_user_info

  The linked Google account: picture (linking to Google Calendar or Drive), name, e-mail and a logout link.

  Context variables required for this template:
  * userurl - Plain URL the picture links to (Google Calendar, Google Drive or #).
  * picture - Base64-encoded JPEG of the Google profile picture (may be empty).
  * name - Plain-text name of the Google account.
  * username - Plain-text e-mail of the Google account.
  * logouturl - Plain URL of the current page with logout=1 and sesskey.
  * logouticon - Trusted HTML of the logout icon (pix_icon).

  Example context (json):
  {
    "userurl": "https://calendar.google.com/",
    "picture": "SlBFR0RBVEE=",
    "name": "Ana Docente",
    "username": "teacher@example.com",
    "logouturl": "https://example.com/course/modedit.php?update=5&logout=1&sesskey=abc",
    "logouticon": "<i class=\"icon fa fa-sign-out fa-fw m-0\" aria-hidden=\"true\"></i>"
  }
}}
<div id="googlemeet_auth-info">
    <a id="googlemeet_picture-user" target="_blank" title="{{#cleanstr}} manage, mod_googlemeet {{/cleanstr}}" href="{{userurl}}"><img src="data:image/jpeg;base64,{{picture}}" alt=""></a>
    <div id="googlemeet_user-name"><span>{{#str}} loggedinaccount, mod_googlemeet {{/str}}</span><span>{{name}}</span><span>{{username}}</span></div>
    <a class="btn btn-secondary btn-sm" title="{{#cleanstr}} logout, mod_googlemeet {{/cleanstr}}" href="{{logouturl}}">{{{logouticon}}}</a>
</div>
