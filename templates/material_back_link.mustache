{{!
  @template mod_googlemeet/material_back_link

  The "Back" link above the recording materials form.

  Context variables required for this template:
  * url - the recording's Materials tab URL (moodle_url::out(false))

  Example context (json):
  {
    "url": "https://example.com/mod/googlemeet/view.php?id=2&recording=5&tab=materials"
  }
}}
<a class="btn btn-link px-0" href="{{url}}">&lsaquo; {{#str}} back {{/str}}</a>
