{{!
  @template mod_googlemeet/google_admin_status_link

  Link from the plugin settings page to the sync status page (admin_status.php).

  Context variables required for this template:
  * url - Plain URL of the sync status page.

  Example context (json):
  {
    "url": "https://example.com/mod/googlemeet/admin_status.php"
  }
}}
<a href="{{url}}">{{#str}} adminstatus_link, mod_googlemeet {{/str}}</a>
