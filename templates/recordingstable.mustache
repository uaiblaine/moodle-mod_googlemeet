{{!
  @template mod_googlemeet/recordingstable

  Example context (json):
  {
    "recordings": [
      {
        "id": 1,
        "googlemeetid": 2,
        "name": "Session recording",
        "createdtime": 1605140304,
        "duration": "1:00:00",
        "webviewlink": "https://drive.google.com/file/d/xxx/view",
        "visible": 1,
        "createdtimeformatted": "Sunday, 23 April 2023, 1:47 PM"
      }
    ],
    "hasrecordings": true,
    "coursemoduleid": 1919,
    "hascapability": 1,
    "aienabled": 1,
    "cangenerateai": 1,
    "sortdescurl": "https://example.com/mod/googlemeet/view.php?id=1919&rorder=DESC",
    "sortascurl": "https://example.com/mod/googlemeet/view.php?id=1919&rorder=ASC",
    "previouspageurl": "https://example.com/mod/googlemeet/view.php?id=1919&rorder=DESC&rpage=0",
    "nextpageurl": "https://example.com/mod/googlemeet/view.php?id=1919&rorder=DESC&rpage=2",
    "pages": [
      {"number": 1, "page": 0, "active": false, "url": "https://example.com/mod/googlemeet/view.php?id=1919&rorder=DESC&rpage=0"}
    ]
  }
}}
<div id="googlemeet_recordings_table" class="googlemeet-recordings-container">
  <div class="googlemeet-recordings-header d-flex justify-content-between align-items-center flex-wrap mb-3">
    <h4 class="googlemeet-section-title mb-0">
      {{# str }} classroom_lessons, mod_googlemeet {{/ str }}
      {{#totalrecordings}}<span class="badge bg-secondary text-dark ms-2">{{totalrecordings}}</span>{{/totalrecordings}}
    </h4>

    {{#cansubscriberecordings}}
    <form method="post" action="view.php" class="googlemeet-subscribe-form mb-0">
      <input type="hidden" name="id" value="{{coursemoduleid}}">
      <input type="hidden" name="sesskey" value="{{sesskey}}">
      {{#issubscribed}}
        <input type="hidden" name="subscribe" value="0">
        <button type="submit" class="btn btn-outline-secondary btn-sm">
          {{# str }} unsubscriberecordings, mod_googlemeet {{/ str }}
        </button>
      {{/issubscribed}}
      {{^issubscribed}}
        <input type="hidden" name="subscribe" value="1">
        <button type="submit" class="btn btn-outline-primary btn-sm">
          {{# str }} subscriberecordings, mod_googlemeet {{/ str }}
        </button>
      {{/issubscribed}}
    </form>
    {{/cansubscriberecordings}}
  </div>

  {{#hascapability}}{{#hasdeletedrecordings}}
  <details class="googlemeet-recordings-trash mb-3">
    <summary class="btn btn-outline-secondary btn-sm">
      {{# str }} recordings_trash_count, mod_googlemeet, {{deletedrecordingcount}} {{/ str }}
    </summary>
    <div class="googlemeet-recordings-trash-panel mt-2">
      <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
          <thead>
            <tr>
              <th scope="col">{{# str }} name {{/ str }}</th>
              <th scope="col">{{# str }} recordings_trash_created_at, mod_googlemeet {{/ str }}</th>
              <th scope="col">{{# str }} recordings_trash_deleted_at, mod_googlemeet {{/ str }}</th>
              <th scope="col" class="text-end">{{# str }} actions {{/ str }}</th>
            </tr>
          </thead>
          <tbody>
            {{#deletedrecordings}}
            <tr data-trash-recordingid="{{id}}">
              <td>{{name}}</td>
              <td>{{createdtimeformatted}}</td>
              <td>{{timedeletedformatted}}{{#purgenotice}}<div class="small text-muted googlemeet-trash-purgenotice">{{purgenotice}}</div>{{/purgenotice}}</td>
              <td class="text-end">
                <button type="button" class="btn btn-sm btn-outline-primary googlemeet-restore-recording" data-id="{{id}}">
                  {{# str }} recording_restore, mod_googlemeet {{/ str }}
                </button>
                {{#canpurge}}
                <button type="button" class="btn btn-sm btn-outline-danger googlemeet-purge-recording" data-id="{{id}}">
                  {{# str }} recording_purge, mod_googlemeet {{/ str }}
                </button>
                {{/canpurge}}
              </td>
            </tr>
            {{/deletedrecordings}}
          </tbody>
        </table>
      </div>
    </div>
  </details>
  {{/hasdeletedrecordings}}{{/hascapability}}

  {{#showprogresssummary}}
  <div class="googlemeet-progress-summary">
    <div class="googlemeet-pending-toggle" role="group" aria-label="{{# str }} recordings_pending_filter_aria, mod_googlemeet {{/ str }}">
      <a href="{{allfilterurl}}" class="googlemeet-pending-option {{^ispendingfilter}}active{{/ispendingfilter}}" {{^ispendingfilter}}aria-current="true"{{/ispendingfilter}}>{{# str }} recordings_filter_all, mod_googlemeet {{/ str }}</a>
      <a href="{{pendingfilterurl}}" class="googlemeet-pending-option {{#ispendingfilter}}active{{/ispendingfilter}}" {{#ispendingfilter}}aria-current="true"{{/ispendingfilter}}>{{# str }} recordings_filter_pending, mod_googlemeet, {{pendingcount}} {{/ str }}</a>
    </div>
  </div>
  {{/showprogresssummary}}

  {{#showfilterbar}}
  {{! Search filters as you type (debounced auto-submit, server-side filtering and pagination). Topic, order
      and view live in a "Filters" panel that is open on desktop and collapsed on phones. }}
  <form method="get" action="view.php#googlemeet_recordings_table" id="googlemeet-filter-form-{{coursemoduleid}}"
        class="googlemeet-recordings-filterbar mb-3" data-region="recordings-filterbar">
    <input type="hidden" name="id" value="{{coursemoduleid}}">
    <input type="hidden" name="rorder" value="{{#isorderdesc}}DESC{{/isorderdesc}}{{#isorderasc}}ASC{{/isorderasc}}">
    {{#ispendingfilter}}<input type="hidden" name="rpending" value="1">{{/ispendingfilter}}
    <div class="googlemeet-filterbar-search">
      <label class="visually-hidden" for="googlemeet-rq">{{# str }} recordings_search_label, mod_googlemeet {{/ str }}</label>
      <input type="search" id="googlemeet-rq" name="rq" value="{{recordingquery}}" class="form-control form-control-sm" autocomplete="off"
             placeholder="{{#hascapability}}{{# str }} recordings_search_placeholder, mod_googlemeet {{/ str }}{{/hascapability}}{{^hascapability}}{{# str }} recordings_search_placeholder_student, mod_googlemeet {{/ str }}{{/hascapability}}">
      <button type="submit" class="btn btn-sm btn-primary googlemeet-filter-submit">{{# str }} recordings_search_button, mod_googlemeet {{/ str }}</button>
    </div>
    <details class="googlemeet-filters-panel" open>
      <summary class="btn btn-outline-secondary btn-sm googlemeet-filters-summary">
        {{# str }} recordings_filters, mod_googlemeet {{/ str }}
        {{#activefiltercount}}<span class="badge rounded-pill bg-primary text-white googlemeet-filters-count" aria-label="{{# str }} recordings_filters_active, mod_googlemeet, {{activefiltercount}} {{/ str }}">{{activefiltercount}}</span>{{/activefiltercount}}
      </summary>
      <div class="googlemeet-filters-body">
        {{#alltopics.0}}
        <div class="googlemeet-filters-group">
          <label class="visually-hidden" for="googlemeet-topic-select">{{# str }} recordings_filter_all_topics, mod_googlemeet {{/ str }}</label>
          <select name="topic" id="googlemeet-topic-select" class="form-select form-select-sm">
            <option value="">{{# str }} recordings_filter_all_topics, mod_googlemeet {{/ str }}</option>
            {{#alltopics}}<option value="{{text}}" {{#active}}selected{{/active}}>{{text}}</option>{{/alltopics}}
          </select>
        </div>
        {{/alltopics.0}}
        <div class="googlemeet-filters-group googlemeet-recordings-controls">
          {{! Sort and page links are complete URLs built in PHP (moodle_url, so the search and the topic arrive
              URL-encoded and only HTML-escaped here). Sort links return to the first page. }}
          <span class="googlemeet-filters-label small text-muted">{{# str }} recordings_sort_by, mod_googlemeet {{/ str }}:</span>
          <div class="btn-group btn-group-sm googlemeet-sort-toggle" role="group" aria-label="{{# str }} recordings_sort_by, mod_googlemeet {{/ str }}">
            <a href="{{sortdescurl}}"
               class="btn {{#isorderdesc}}btn-primary{{/isorderdesc}}{{^isorderdesc}}btn-outline-secondary{{/isorderdesc}}" {{#isorderdesc}}aria-current="true"{{/isorderdesc}}>
              <span class="googlemeet-sort-label-full">{{# str }} recordingsorder_desc, mod_googlemeet {{/ str }}</span>
              <span class="googlemeet-sort-label-short">{{# str }} recordingsorder_desc_short, mod_googlemeet {{/ str }}</span>
            </a>
            <a href="{{sortascurl}}"
               class="btn {{#isorderasc}}btn-primary{{/isorderasc}}{{^isorderasc}}btn-outline-secondary{{/isorderasc}}" {{#isorderasc}}aria-current="true"{{/isorderasc}}>
              <span class="googlemeet-sort-label-full">{{# str }} recordingsorder_asc, mod_googlemeet {{/ str }}</span>
              <span class="googlemeet-sort-label-short">{{# str }} recordingsorder_asc_short, mod_googlemeet {{/ str }}</span>
            </a>
          </div>
        </div>
        <div class="googlemeet-filters-group googlemeet-recordings-controls">
          <span class="googlemeet-filters-label small text-muted">{{# str }} recordings_view_label, mod_googlemeet {{/ str }}:</span>
          <div class="btn-group btn-group-sm googlemeet-view-toggle" role="radiogroup" aria-label="{{# str }} recordings_view_label, mod_googlemeet {{/ str }}">
            <a href="{{viewcardsurl}}" role="radio"
               class="btn {{#isviewcards}}btn-primary active{{/isviewcards}}{{^isviewcards}}btn-outline-secondary{{/isviewcards}}"
               aria-checked="{{#isviewcards}}true{{/isviewcards}}{{^isviewcards}}false{{/isviewcards}}"
               {{#isviewcards}}aria-current="true"{{/isviewcards}}
               aria-label="{{# str }} recordings_view_cards_aria, mod_googlemeet {{/ str }}">
              {{# pix }} i/grades, core {{/ pix }} {{# str }} recordings_view_cards, mod_googlemeet {{/ str }}
            </a>
            <a href="{{viewlisturl}}" role="radio"
               class="btn {{#isviewlist}}btn-primary active{{/isviewlist}}{{^isviewlist}}btn-outline-secondary{{/isviewlist}}"
               aria-checked="{{#isviewlist}}true{{/isviewlist}}{{^isviewlist}}false{{/isviewlist}}"
               {{#isviewlist}}aria-current="true"{{/isviewlist}}
               aria-label="{{# str }} recordings_view_list_aria, mod_googlemeet {{/ str }}">
              {{# pix }} i/menu, core {{/ pix }} {{# str }} recordings_view_list, mod_googlemeet {{/ str }}
            </a>
          </div>
        </div>
      </div>
    </details>
    {{#hasactivefilters}}<a href="{{clearfiltersurl}}" class="btn btn-sm btn-link googlemeet-filters-clear">{{# str }} recordings_filter_clear, mod_googlemeet {{/ str }}</a>{{/hasactivefilters}}
  </form>
  {{/showfilterbar}}

  {{#hasrecordings}}
  {{#recordingquery}}
  <div class="googlemeet-recordings-queryinfo small mb-1" role="status">
    {{#hascapability}}{{# str }} recordings_query_results, mod_googlemeet, {"query": {{# quote }}{{recordingquery}}{{/ quote }}, "total": "{{totalrecordings}}"} {{/ str }}{{/hascapability}}
    {{^hascapability}}{{# str }} recordings_query_results_student, mod_googlemeet, {"query": {{# quote }}{{recordingquery}}{{/ quote }}, "total": "{{totalrecordings}}"} {{/ str }}{{/hascapability}}
  </div>
  {{/recordingquery}}
  {{#haspagination}}
  <div class="googlemeet-recordings-info small text-muted mb-2">
    {{# str }} recordings_pagination_info, mod_googlemeet, {"start": "{{start}}", "end": "{{end}}", "total": "{{totalrecordings}}"} {{/ str }}
  </div>
  {{/haspagination}}
  <div class="googlemeet-recordings-{{#isviewlist}}listview{{/isviewlist}}{{#isviewcards}}grid{{/isviewcards}}">
    {{#recordings}}
        {{#showdategroup}}<h5 class="googlemeet-recordings-group w-100">{{dategroup}}</h5>{{/showdategroup}}
        {{#isviewcards}}
        <div id="googlemeet-recording-{{id}}" class="googlemeet-recording-card {{^visible}}googlemeet-recording-hidden{{/visible}} {{#hasai}}googlemeet-recording-has-ai{{/hasai}}" data-recordingid="{{id}}">
          <a href="{{huburl}}" class="googlemeet-card-media" title="{{originalname}}" aria-label="{{# str }} recording_play_aria, mod_googlemeet {{/ str }}: {{displayname}}">
            <span class="googlemeet-card-play" aria-hidden="true">{{# pix }} play, mod_googlemeet {{/ pix }}</span>
            <span class="googlemeet-card-date" aria-hidden="true">{{createddateshort}}</span>
            <span class="googlemeet-card-badges">
              {{#isnew}}<span class="googlemeet-card-newbadge">{{# str }} recording_new, mod_googlemeet {{/ str }}</span>{{/isnew}}
              {{#hasai}}<span class="googlemeet-card-aibadge" title="{{# str }} ai_analysis_available, mod_googlemeet {{/ str }}">{{# str }} ai_badge_label, mod_googlemeet {{/ str }}</span>{{/hasai}}{{#aipendingreview}}<span class="googlemeet-ai-review-chip">{{# str }} aireview_chip, mod_googlemeet {{/ str }}</span>{{/aipendingreview}}
            </span>
            <span class="googlemeet-card-duration">{{duration}}</span>
          </a>
          <div class="googlemeet-card-body">
            <div class="googlemeet-card-title">
              <a href="{{huburl}}" class="recording-name-text" title="{{originalname}}" data-originalname="{{originalname}}">{{displayname}}</a>
            </div>
            <div class="googlemeet-card-meta">
              <span class="googlemeet-recording-date visually-hidden">{{createdtimeformatted}}</span>
              {{#hasai}}<span class="googlemeet-ai-keypoints-count">{{aikeypointslabel}}</span>{{/hasai}}
              {{#haspublishedquestions}}<span class="googlemeet-lesson-test-badge">{{# str }} lesson_has_test, mod_googlemeet {{/ str }}</span>{{/haspublishedquestions}}
              {{^hasai}}
                {{#aistatusisprocessing}}<span class="googlemeet-ai-statuschip googlemeet-ai-statuschip-processing">{{# str }} ai_status_chip_processing, mod_googlemeet {{/ str }}</span>{{/aistatusisprocessing}}{{#aistatusisstuck}}<span class="googlemeet-ai-statuschip googlemeet-ai-statuschip-failed">{{# str }} ai_status_chip_stuck, mod_googlemeet {{/ str }}</span>{{/aistatusisstuck}}
                {{#aistatusispending}}<span class="googlemeet-ai-statuschip googlemeet-ai-statuschip-pending">{{# str }} ai_status_chip_pending, mod_googlemeet {{/ str }}</span>{{/aistatusispending}}
                {{#aistatusisfailed}}
                  {{#hascapability}}<span class="googlemeet-ai-statuschip googlemeet-ai-statuschip-failed">{{# str }} ai_status_chip_failed_teacher, mod_googlemeet {{/ str }}</span>{{/hascapability}}
                  {{^hascapability}}<span class="googlemeet-ai-statuschip googlemeet-ai-statuschip-muted">{{# str }} ai_status_chip_failed_student, mod_googlemeet {{/ str }}</span>{{/hascapability}}
                {{/aistatusisfailed}}
              {{/hasai}}
            </div>
            {{#hasai}}
            <p class="googlemeet-card-summary">{{aisummarypreview}}</p>
            {{#aitopicsvisible.0}}<div class="googlemeet-card-topics">{{#aitopicsvisible}}<span class="googlemeet-ai-topic-tag">{{.}}</span>{{/aitopicsvisible}}{{#aitopicsoverflow}}<span class="googlemeet-ai-topic-tag googlemeet-topic-overflow" title="{{# str }} recordings_topics_overflow_aria, mod_googlemeet, {{aitopicsoverflow}} {{/ str }}" aria-label="{{# str }} recordings_topics_overflow_aria, mod_googlemeet, {{aitopicsoverflow}} {{/ str }}">+{{aitopicsoverflow}}</span>{{/aitopicsoverflow}}</div>{{/aitopicsvisible.0}}
            {{/hasai}}
            {{#matchsource}}
            <div class="googlemeet-search-match">
              <span class="googlemeet-search-match-source">{{matchsource}}</span>
              {{#matchsnippet}}<span class="googlemeet-search-match-snippet">{{matchsnippet}}</span>{{/matchsnippet}}
            </div>
            {{/matchsource}}
            {{#hascapability}}
            <div class="googlemeet-card-progress googlemeet-teacher-stats">{{> mod_googlemeet/local/recording_teacher_stats }}</div>
            {{/hascapability}}
            {{^hascapability}}
            <div class="googlemeet-card-progress" data-region="recording-progress" aria-label="{{progressarialabel}}">
              <span class="googlemeet-progress-badge {{#progresscompleted}}googlemeet-progress-badge-completed{{/progresscompleted}}{{#progresspartial}}googlemeet-progress-badge-partial{{/progresspartial}}{{#progressunseen}}googlemeet-progress-badge-unseen{{/progressunseen}}">
                {{#progresscompleted}}<span aria-hidden="true">&#10003;</span>{{/progresscompleted}}
                {{#progressunseen}}<span aria-hidden="true">&#9675;</span>{{/progressunseen}}
                <span class="googlemeet-progress-status-text">{{progressstatuslabel}}</span>
              </span>
              {{#showprogressbar}}
                <div class="googlemeet-progress-line">
                  <div class="progress googlemeet-progress-meter" role="progressbar" aria-label="{{# str }} recording_progress_meter, mod_googlemeet {{/ str }}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{progresspct}}">
                    <div class="progress-bar" style="{{progressbarstyle}}"></div>
                  </div>
                  <span class="googlemeet-progress-percent">{{progresspcttext}}</span>
                </div>
              {{/showprogressbar}}
            </div>
            {{/hascapability}}
            <div class="googlemeet-card-footer">
              <a href="{{huburl}}" class="btn btn-primary btn-sm googlemeet-card-cta">{{# str }} recording_watch_cta, mod_googlemeet {{/ str }}</a>
              <div class="googlemeet-card-actions googlemeet-recording-actions">
                {{^hascapability}}<a href="{{webviewlink}}" target="_blank" rel="noopener" class="googlemeet-drive-link" title="{{# str }} openindrive, mod_googlemeet {{/ str }}: {{originalname}}" aria-label="{{# str }} openindrive, mod_googlemeet {{/ str }}: {{displayname}}">{{# pix }} i/externallink, core {{/ pix }}</a>{{/hascapability}}
                {{#hascapability}}{{> mod_googlemeet/local/recording_row_actions }}{{/hascapability}}
              </div>
            </div>
          </div>

          {{! Materials: download chips for the first two files plus a link to the rest; teachers manage them
              from the row's Actions menu. }}
          {{#hascapability}}
          {{#hasmaterials}}
          <div class="googlemeet-card-materials mt-2">
            <div class="googlemeet-materials-list googlemeet-materials-list-card">
              {{#cardmaterials}}
              <a href="{{url}}" class="googlemeet-material-row" aria-label="{{# str }} download, core {{/ str }} {{name}}">
                <span class="googlemeet-material-file">
                  <img src="{{icon}}" class="googlemeet-material-icon" alt="" aria-hidden="true">
                  <span class="googlemeet-material-details">
                    <span class="googlemeet-material-name">{{name}}</span>
                    <span class="googlemeet-material-separator" aria-hidden="true">&middot;</span>
                    <span class="googlemeet-material-size">{{size}}</span>
                  </span>
                </span>
                <span class="googlemeet-material-download" aria-hidden="true">{{# pix }} t/download, core {{/ pix }}</span>
              </a>
              {{/cardmaterials}}
              {{#cardhasmaterialoverflow}}
              <a href="{{materialshuburl}}" class="googlemeet-material-more" aria-label="{{# str }} materials_more_aria, mod_googlemeet, {{cardmaterialoverflow}} {{/ str }}">{{# str }} materials_more, mod_googlemeet, {{cardmaterialoverflow}} {{/ str }}</a>
              {{/cardhasmaterialoverflow}}
            </div>
          </div>
          {{/hasmaterials}}
          {{/hascapability}}
          {{^hascapability}}{{#hasmaterials}}
          <div class="googlemeet-card-materials mt-2">
            <span class="small">{{# str }} hub_tab_materials, mod_googlemeet {{/ str }}:</span>
            <div class="googlemeet-materials-list googlemeet-materials-list-card">
              {{#cardmaterials}}
              <a href="{{url}}" class="googlemeet-material-row" aria-label="{{# str }} download, core {{/ str }} {{name}}">
                <span class="googlemeet-material-file">
                  <img src="{{icon}}" class="googlemeet-material-icon" alt="" aria-hidden="true">
                  <span class="googlemeet-material-details">
                    <span class="googlemeet-material-name">{{name}}</span>
                    <span class="googlemeet-material-separator" aria-hidden="true">&middot;</span>
                    <span class="googlemeet-material-size">{{size}}</span>
                  </span>
                </span>
                <span class="googlemeet-material-download" aria-hidden="true">{{# pix }} t/download, core {{/ pix }}</span>
              </a>
              {{/cardmaterials}}
              {{#cardhasmaterialoverflow}}
              <a href="{{materialshuburl}}" class="googlemeet-material-more" aria-label="{{# str }} materials_more_aria, mod_googlemeet, {{cardmaterialoverflow}} {{/ str }}">{{# str }} materials_more, mod_googlemeet, {{cardmaterialoverflow}} {{/ str }}</a>
              {{/cardhasmaterialoverflow}}
            </div>
          </div>
          {{/hasmaterials}}{{/hascapability}}

          {{! Student-only summary link stays inside the card. }}
          {{#aienabled}}
            {{^hascapability}}
              {{#hasai}}<a href="{{huburl}}" class="googlemeet-card-summarylink">{{# str }} recording_view_summary, mod_googlemeet {{/ str }} ›</a>{{/hasai}}
            {{/hascapability}}
          {{/aienabled}}
        </div>
        {{/isviewcards}}

        {{#isviewlist}}
        {{! Compact two-line list row. Reuses the same per-recording fields as the card and
            the same teacher controls, so the shared full-width AI panel row below works
            identically (the toggle finds the panel by data-recordingid). }}
        <div id="googlemeet-recording-{{id}}" class="googlemeet-recording-listitem {{^visible}}googlemeet-recording-hidden{{/visible}} {{#hasai}}googlemeet-recording-has-ai{{/hasai}}" data-recordingid="{{id}}">
          <div class="googlemeet-listitem-date" aria-hidden="true">{{createddateshort}}</div>
          <div class="googlemeet-listitem-main">
            <div class="googlemeet-listitem-title googlemeet-card-title">
              <a href="{{huburl}}" class="recording-name-text" title="{{originalname}}" data-originalname="{{originalname}}">{{displayname}}</a>
              {{#isnew}}<span class="googlemeet-card-newbadge">{{# str }} recording_new, mod_googlemeet {{/ str }}</span>{{/isnew}}
              {{#hascapability}}{{^visible}}<span class="googlemeet-listitem-hidden-tag">{{# str }} recording_hidden, mod_googlemeet {{/ str }}</span>{{/visible}}{{/hascapability}}
              {{#hasai}}<span class="googlemeet-card-aibadge" title="{{# str }} ai_analysis_available, mod_googlemeet {{/ str }}">{{# str }} ai_badge_label, mod_googlemeet {{/ str }}</span>{{/hasai}}{{#aipendingreview}}<span class="googlemeet-ai-review-chip">{{# str }} aireview_chip, mod_googlemeet {{/ str }}</span>{{/aipendingreview}}
              <span class="googlemeet-recording-date visually-hidden">{{createdtimeformatted}}</span>
            </div>
            <div class="googlemeet-listitem-meta googlemeet-card-meta">
              <span class="googlemeet-listitem-duration">{{duration}}</span>
              {{#hasai}}<span class="googlemeet-ai-keypoints-count">{{aikeypointslabel}}</span>{{/hasai}}
              {{#haspublishedquestions}}<span class="googlemeet-lesson-test-badge">{{# str }} lesson_has_test, mod_googlemeet {{/ str }}</span>{{/haspublishedquestions}}
              {{^hasai}}
                {{#aistatusisprocessing}}<span class="googlemeet-ai-statuschip googlemeet-ai-statuschip-processing">{{# str }} ai_status_chip_processing, mod_googlemeet {{/ str }}</span>{{/aistatusisprocessing}}{{#aistatusisstuck}}<span class="googlemeet-ai-statuschip googlemeet-ai-statuschip-failed">{{# str }} ai_status_chip_stuck, mod_googlemeet {{/ str }}</span>{{/aistatusisstuck}}
                {{#aistatusispending}}<span class="googlemeet-ai-statuschip googlemeet-ai-statuschip-pending">{{# str }} ai_status_chip_pending, mod_googlemeet {{/ str }}</span>{{/aistatusispending}}
                {{#aistatusisfailed}}
                  {{#hascapability}}<span class="googlemeet-ai-statuschip googlemeet-ai-statuschip-failed">{{# str }} ai_status_chip_failed_teacher, mod_googlemeet {{/ str }}</span>{{/hascapability}}
                  {{^hascapability}}<span class="googlemeet-ai-statuschip googlemeet-ai-statuschip-muted">{{# str }} ai_status_chip_failed_student, mod_googlemeet {{/ str }}</span>{{/hascapability}}
                {{/aistatusisfailed}}
              {{/hasai}}
              {{#aitopicsvisible.0}}{{#aitopicsvisible}}<span class="googlemeet-ai-topic-tag">{{.}}</span>{{/aitopicsvisible}}{{#aitopicsoverflow}}<span class="googlemeet-ai-topic-tag googlemeet-topic-overflow" title="{{# str }} recordings_topics_overflow_aria, mod_googlemeet, {{aitopicsoverflow}} {{/ str }}" aria-label="{{# str }} recordings_topics_overflow_aria, mod_googlemeet, {{aitopicsoverflow}} {{/ str }}">+{{aitopicsoverflow}}</span>{{/aitopicsoverflow}}{{/aitopicsvisible.0}}
            </div>
            {{#hasai}}{{#aisummarypreview}}<p class="googlemeet-listitem-summary">{{aisummarypreview}}</p>{{/aisummarypreview}}{{/hasai}}
            {{#matchsource}}
            <div class="googlemeet-search-match">
              <span class="googlemeet-search-match-source">{{matchsource}}</span>
              {{#matchsnippet}}<span class="googlemeet-search-match-snippet">{{matchsnippet}}</span>{{/matchsnippet}}
            </div>
            {{/matchsource}}
            {{! Materials row: same visibility rules as the card view, but lists every file (no overflow link). }}
            {{#hascapability}}
            {{#hasmaterials}}
            <div class="googlemeet-card-materials mt-1">
              <div class="googlemeet-materials-list googlemeet-materials-list-compact">
                {{#materials}}
                <a href="{{url}}" class="googlemeet-material-row googlemeet-material-row-compact" aria-label="{{# str }} download, core {{/ str }} {{name}}">
                  <span class="googlemeet-material-file">
                    <img src="{{icon}}" class="googlemeet-material-icon" alt="" aria-hidden="true">
                    <span class="googlemeet-material-details">
                      <span class="googlemeet-material-name">{{name}}</span>
                      <span class="googlemeet-material-separator" aria-hidden="true">&middot;</span>
                      <span class="googlemeet-material-size">{{size}}</span>
                    </span>
                  </span>
                  <span class="googlemeet-material-download" aria-hidden="true">{{# pix }} t/download, core {{/ pix }}</span>
                </a>
                {{/materials}}
              </div>
            </div>
            {{/hasmaterials}}
            {{/hascapability}}
            {{^hascapability}}{{#hasmaterials}}
            <div class="googlemeet-card-materials mt-1">
              <span class="small">{{# str }} hub_tab_materials, mod_googlemeet {{/ str }}:</span>
              <div class="googlemeet-materials-list googlemeet-materials-list-compact">
                {{#materials}}
                <a href="{{url}}" class="googlemeet-material-row googlemeet-material-row-compact" aria-label="{{# str }} download, core {{/ str }} {{name}}">
                  <span class="googlemeet-material-file">
                    <img src="{{icon}}" class="googlemeet-material-icon" alt="" aria-hidden="true">
                    <span class="googlemeet-material-details">
                      <span class="googlemeet-material-name">{{name}}</span>
                      <span class="googlemeet-material-separator" aria-hidden="true">&middot;</span>
                      <span class="googlemeet-material-size">{{size}}</span>
                    </span>
                  </span>
                  <span class="googlemeet-material-download" aria-hidden="true">{{# pix }} t/download, core {{/ pix }}</span>
                </a>
                {{/materials}}
              </div>
            </div>
            {{/hasmaterials}}{{/hascapability}}
          </div>
          {{#hascapability}}
          <div class="googlemeet-listitem-progress googlemeet-teacher-stats">{{> mod_googlemeet/local/recording_teacher_stats }}</div>
          {{/hascapability}}
          {{^hascapability}}
          <div class="googlemeet-listitem-progress" data-region="recording-progress" aria-label="{{progressarialabel}}">
            <span class="googlemeet-progress-badge {{#progresscompleted}}googlemeet-progress-badge-completed{{/progresscompleted}}{{#progresspartial}}googlemeet-progress-badge-partial{{/progresspartial}}{{#progressunseen}}googlemeet-progress-badge-unseen{{/progressunseen}}">
              {{#progresscompleted}}<span aria-hidden="true">&#10003;</span>{{/progresscompleted}}
              {{#progressunseen}}<span aria-hidden="true">&#9675;</span>{{/progressunseen}}
              <span class="googlemeet-progress-status-text">{{progressstatuslabel}}</span>
            </span>
            {{#showprogressbar}}
              <div class="googlemeet-progress-line">
                <div class="progress googlemeet-progress-meter" role="progressbar" aria-label="{{# str }} recording_progress_meter, mod_googlemeet {{/ str }}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{progresspct}}">
                  <div class="progress-bar" style="{{progressbarstyle}}"></div>
                </div>
                <span class="googlemeet-progress-percent">{{progresspcttext}}</span>
              </div>
            {{/showprogressbar}}
          </div>
          {{/hascapability}}
          <div class="googlemeet-listitem-actions googlemeet-recording-actions">
            <a href="{{huburl}}" class="btn btn-primary btn-sm googlemeet-card-cta">{{# str }} recording_watch_cta, mod_googlemeet {{/ str }}</a>
            {{^hascapability}}<a href="{{webviewlink}}" target="_blank" rel="noopener" class="googlemeet-drive-link" title="{{# str }} openindrive, mod_googlemeet {{/ str }}: {{originalname}}" aria-label="{{# str }} openindrive, mod_googlemeet {{/ str }}: {{displayname}}">{{# pix }} i/externallink, core {{/ pix }}</a>{{/hascapability}}
            {{#hascapability}}{{> mod_googlemeet/local/recording_row_actions }}{{/hascapability}}
            {{#aienabled}}{{^hascapability}}
              {{#hasai}}<a href="{{huburl}}" class="googlemeet-card-summarylink">{{# str }} recording_view_summary, mod_googlemeet {{/ str }} ›</a>{{/hasai}}
            {{/hascapability}}{{/aienabled}}
          </div>
        </div>
        {{/isviewlist}}

        {{!
          Expandable AI panel, rendered as a full-width sibling row after the card or list item
          rather than nested inside it, so expanding one card leaves no hole in the grid (the open
          row spans grid-column: 1 / -1). It is keyed only by recording id, so both views share it.
        }}
        {{#aienabled}}
            {{#hascapability}}
            <div class="googlemeet-ai-panel-row" data-recordingid="{{id}}">
            <div class="googlemeet-ai-panel" id="googlemeet-ai-panel-{{id}}" data-recordingid="{{id}}" style="display: none;">
            <div class="googlemeet-ai-header">
              <h5>{{# str }} ai_analysis, mod_googlemeet {{/ str }}</h5>
              <div class="googlemeet-ai-header-actions">
                {{#hasai}}
                  <span class="googlemeet-ai-generated-date">{{# str }} ai_generated_on, mod_googlemeet {{/ str }} {{aidate}}</span>
                {{/hasai}}
                {{#cangenerateai}}
                <button class="btn btn-sm btn-primary googlemeet-ai-generate-btn" data-id="{{id}}">
                  {{#hasai}}{{# str }} ai_regenerate, mod_googlemeet {{/ str }}{{/hasai}}
                  {{^hasai}}{{# str }} ai_generate, mod_googlemeet {{/ str }}{{/hasai}}
                </button>
                {{/cangenerateai}}
                {{#hascapability}}
                <button class="btn btn-sm btn-outline-secondary googlemeet-ai-edit-btn ms-1" data-id="{{id}}" data-recordingname="{{originalname}}" title="{{# str }} ai_edit_manual, mod_googlemeet {{/ str }}">
                  {{# pix }} i/edit, core {{/ pix }}
                  {{# str }} ai_edit_manual, mod_googlemeet {{/ str }}
                </button>
                {{/hascapability}}
              </div>
            </div>
            <div class="googlemeet-ai-content" data-recordingid="{{id}}" data-hasai="{{#hasai}}1{{/hasai}}{{^hasai}}0{{/hasai}}">
              <div class="googlemeet-ai-loading" style="display: none;">
                <div class="googlemeet-ai-loading-spinner"></div>
                <p>{{# str }} ai_generating, mod_googlemeet {{/ str }}</p>
              </div>
              {{^hasai}}
              <div class="googlemeet-ai-nodata">
                <div class="googlemeet-ai-nodata-icon">
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 2L14.09 8.26L20.5 8.27L15.21 12.14L17.29 18.39L12 14.53L6.71 18.39L8.79 12.14L3.5 8.27L9.91 8.26L12 2Z" fill="currentColor" opacity="0.3"/>
                  </svg>
                </div>
                <p>{{# str }} ai_noanalysis, mod_googlemeet {{/ str }}</p>
                {{#cangenerateai}}
                <p class="googlemeet-ai-nodata-hint">{{# str }} ai_noanalysis_hint, mod_googlemeet {{/ str }}</p>
                {{/cangenerateai}}
              </div>
              {{/hasai}}
              {{#hasai}}
              {{> mod_googlemeet/local/ai_result }}
              {{/hasai}}
              <div class="googlemeet-ai-error" role="alert" style="display: none;">
                <div class="alert alert-danger"></div>
              </div>
            </div>
          </div>
          </div>
            {{/hascapability}}
          {{/aienabled}}
    {{/recordings}}
  </div>

  {{#haspagination}}
  <nav aria-label="{{# str }} recordings_pagination_aria, mod_googlemeet {{/ str }}" class="googlemeet-pagination mt-3">
    <ul class="pagination pagination-sm justify-content-center mb-0">
      {{#hasprevious}}
      <li class="page-item">
        <a class="page-link" href="{{previouspageurl}}">
          &laquo; {{# str }} recordings_page_previous, mod_googlemeet {{/ str }}
        </a>
      </li>
      {{/hasprevious}}
      {{^hasprevious}}
      <li class="page-item disabled">
        <span class="page-link">&laquo; {{# str }} recordings_page_previous, mod_googlemeet {{/ str }}</span>
      </li>
      {{/hasprevious}}

      {{#pages}}
      <li class="page-item {{#active}}active{{/active}}">
        {{#active}}
        <span class="page-link">{{number}}</span>
        {{/active}}
        {{^active}}
        <a class="page-link" href="{{url}}">{{number}}</a>
        {{/active}}
      </li>
      {{/pages}}

      {{#hasnext}}
      <li class="page-item">
        <a class="page-link" href="{{nextpageurl}}">
          {{# str }} recordings_page_next, mod_googlemeet {{/ str }} &raquo;
        </a>
      </li>
      {{/hasnext}}
      {{^hasnext}}
      <li class="page-item disabled">
        <span class="page-link">{{# str }} recordings_page_next, mod_googlemeet {{/ str }} &raquo;</span>
      </li>
      {{/hasnext}}
    </ul>
  </nav>
  {{/haspagination}}
  {{/hasrecordings}}

  {{^hasrecordings}}
    <div class="googlemeet-no-recordings">
      <div class="googlemeet-no-recordings-icon">
        {{# pix }} i/empty, core {{/ pix }}
      </div>
      {{#hasactivefilters}}
        {{#ispendingfilter}}{{#progresssummarydone}}<p class="fw-bold">{{# str }} recordings_pending_none, mod_googlemeet {{/ str }}</p>{{/progresssummarydone}}{{/ispendingfilter}}
        {{#recordingquery}}<p>{{# str }} recordings_no_query_results, mod_googlemeet, {{recordingquery}} {{/ str }}</p>{{/recordingquery}}
        {{^recordingquery}}<p>{{# str }} recordings_no_filter_results, mod_googlemeet {{/ str }}</p>{{/recordingquery}}
        <a href="{{clearfiltersurl}}" class="btn btn-sm btn-link">{{# str }} recordings_filter_clear, mod_googlemeet {{/ str }}</a>
      {{/hasactivefilters}}
      {{^hasactivefilters}}
        <p>{{# str }} thereisnorecordingtoshow, mod_googlemeet {{/ str }}</p>
      {{/hasactivefilters}}
    </div>
  {{/hasrecordings}}

  {{#hascapability}}
  <template id="googlemeet-inline-loading-template"><span class="googlemeet-inline-loading">{{# pix }} i/processing16, googlemeet, {{# str }} loading, mod_googlemeet {{/ str }} {{/ pix }}</span></template>
  {{/hascapability}}

  <div id="googlemeet_syncimg" class="googlemeet-loading-overlay">
    {{# pix }} i/processing64, googlemeet, {{# str }} loading, mod_googlemeet {{/ str }} {{/ pix }}
  </div>

  {{! Modal for manual AI analysis editing }}
  <div class="modal fade" id="googlemeet-ai-edit-modal" tabindex="-1" role="dialog" aria-labelledby="googlemeet-ai-edit-modal-title" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="googlemeet-ai-edit-modal-title">{{# str }} ai_edit_manual_title, mod_googlemeet {{/ str }}</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{# str }} closebuttontitle {{/ str }}"></button>
        </div>
        <div class="modal-body">
          <form id="googlemeet-ai-edit-form">
            <input type="hidden" id="googlemeet-ai-edit-recordingid" value="">
            <div class="mb-3">
              <label for="googlemeet-ai-edit-summary">{{# str }} ai_summary, mod_googlemeet {{/ str }}</label>
              <textarea class="form-control" id="googlemeet-ai-edit-summary" rows="4" placeholder="{{# str }} ai_edit_summary_placeholder, mod_googlemeet {{/ str }}"></textarea>
            </div>
            <div class="mb-3">
              <label for="googlemeet-ai-edit-keypoints">{{# str }} ai_keypoints, mod_googlemeet {{/ str }}</label>
              <textarea class="form-control" id="googlemeet-ai-edit-keypoints" rows="6" placeholder="{{# str }} ai_edit_keypoints_placeholder, mod_googlemeet {{/ str }}"></textarea>
              <small class="form-text text-muted">{{# str }} ai_edit_keypoints_placeholder, mod_googlemeet {{/ str }}</small>
            </div>
            <div class="mb-3">
              <label for="googlemeet-ai-edit-topics">{{# str }} ai_topics, mod_googlemeet {{/ str }}</label>
              <textarea class="form-control" id="googlemeet-ai-edit-topics" rows="2" placeholder="{{# str }} ai_edit_topics_placeholder, mod_googlemeet {{/ str }}"></textarea>
              <small class="form-text text-muted">{{# str }} ai_edit_topics_placeholder, mod_googlemeet {{/ str }}</small>
            </div>
            <div class="mb-3">
              <label for="googlemeet-ai-edit-transcript">{{# str }} ai_transcript, mod_googlemeet {{/ str }}</label>
              <textarea class="form-control" id="googlemeet-ai-edit-transcript" rows="8" placeholder="{{# str }} ai_edit_transcript_placeholder, mod_googlemeet {{/ str }}"></textarea>
              <small class="form-text text-muted d-block">{{# str }} ai_analyze_transcript_hint, mod_googlemeet {{/ str }}</small>
              <div class="googlemeet-ai-analyze-row mt-2">
              <button type="button" class="btn btn-primary btn-sm" id="googlemeet-ai-analyze-transcript">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="me-1">
                  <path d="M12 2L14.09 8.26L20.5 8.27L15.21 12.14L17.29 18.39L12 14.53L6.71 18.39L8.79 12.14L3.5 8.27L9.91 8.26L12 2Z" fill="currentColor"/>
                </svg>
                {{# str }} ai_analyze_with_gemini, mod_googlemeet {{/ str }}
              </button>
              </div>
            </div>
          </form>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{# str }} ai_edit_cancel, mod_googlemeet {{/ str }}</button>
          <button type="button" class="btn btn-primary" id="googlemeet-ai-edit-save">{{# str }} ai_edit_save, mod_googlemeet {{/ str }}</button>
        </div>
      </div>
    </div>
  </div>
</div>

{{#js}}
require(['mod_googlemeet/sync'], function(m) {
  m.init();
});
require(['mod_googlemeet/ai_panel'], function(m) {
  m.init({
    cmid: {{coursemoduleid}},
    canedit: {{#hascapability}}true{{/hascapability}}{{^hascapability}}false{{/hascapability}},
    aienabled: {{#aienabled}}true{{/aienabled}}{{^aienabled}}false{{/aienabled}},
    cangenerateai: {{#cangenerateai}}true{{/cangenerateai}}{{^cangenerateai}}false{{/cangenerateai}}
  });
});
require(['mod_googlemeet/recordings_table'], function(m) {
  m.init({
    cmid: {{coursemoduleid}},
    canmanage: {{#hascapability}}true{{/hascapability}}{{^hascapability}}false{{/hascapability}},
    strings: {
      {{#hascapability}}
      renamelabel: {{# quote }}{{# str }} list_action_rename, mod_googlemeet {{/ str }}{{/ quote }},
      hidden: {{# quote }}{{# str }} recording_hidden, mod_googlemeet {{/ str }}{{/ quote }},
      purge: {{# quote }}{{# str }} recording_purge, mod_googlemeet {{/ str }}{{/ quote }},
      purgeconfirm: {{# quote }}{{# str }} recording_purge_confirm, mod_googlemeet {{/ str }}{{/ quote }},
      trash: {{# quote }}{{# str }} recording_trash, mod_googlemeet {{/ str }}{{/ quote }},
      trashconfirm: {{# quote }}{{# str }} recording_trash_confirm, mod_googlemeet {{/ str }}{{/ quote }}
      {{/hascapability}}
    }
  });
});
{{/js}}
