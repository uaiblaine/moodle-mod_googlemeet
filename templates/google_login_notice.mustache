{{!
  @template mod_googlemeet/google_login_notice

  Notice on the activity settings form asking the teacher to log in to Google, with the login button.

  Context variables required for this template:
  * expired - True when the Google session expired between loading and submitting the form.
  * loginbutton - Trusted HTML of mod_googlemeet/google_login_button, built by client::print_login_popup().

  Example context (json):
  {
    "expired": false,
    "loginbutton": "<div class=\"mt-2\"></div>"
  }
}}
{{#expired}}<div class="mdl-align alert alert-danger googlemeet_loginbutton">{{#str}} sessionexpired, mod_googlemeet {{/str}}{{{loginbutton}}}</div>{{/expired}}
{{^expired}}<div class="mdl-align alert alert-info googlemeet_loginbutton">{{#str}} logintoyourgoogleaccount, mod_googlemeet {{/str}}{{{loginbutton}}}</div>{{/expired}}
