{{!
    @template mod_googlemeet/attendance_page

    Teacher view of the attendance read from Google Meet (attendance.php, below the page heading):
    notices, the past sessions and, for the selected session, its fetch status, the refetch button,
    the export selector and the participants with their link and unlink forms.

    The *html values, loginpopup and downloadselector are core renderer output and are printed raw;
    every other value is plain text. The forms post to attendance.php with the sesskey; the page
    checks mod/googlemeet:manageattendance again before writing.

    Classes and context variables required for this template:
    * notices - rendered notifications shown above the sessions
    * hasloginpopup, loginpopup - the organiser's Google login button
    * hassessions, nosessionshtml - whether there is any past session, and the notice when not
    * sessions - label, selected, url, statuslabel, counts, last
    * hassession, session - the selected session (see attendance_session)

    Example context (json):
    {
        "notices": [{"html": "<div class=\"alert alert-info\">Attendance is not enabled for this activity.</div>"}],
        "hasloginpopup": true,
        "loginpopup": "<button type=\"button\" class=\"btn btn-primary\">Log in</button>",
        "hassessions": true,
        "nosessionshtml": "",
        "sessions": [
            {"label": "9/10/25, 16:53", "selected": true, "url": "#", "statuslabel": "Read",
             "counts": "2 matched of 3", "last": false},
            {"label": "8/10/25, 16:53", "selected": false, "url": "#", "statuslabel": "Not read",
             "counts": "", "last": true}
        ],
        "hassession": true,
        "session": {
            "heading": "Session of 9 October 2025, 4:53 PM", "statuslabel": "Error reading attendance",
            "haserror": true, "errormessage": "Quota exceeded", "hasrefetch": true,
            "refetchhtml": "<button type=\"submit\" class=\"btn btn-secondary\">Read attendance again</button>",
            "hasrows": true, "downloadselector": "", "formaction": "#", "cmid": 3, "sessionid": 7,
            "sesskey": "abc123",
            "options": [{"value": 0, "label": "Choose a student", "selected": true},
                        {"value": 12, "label": "Ana Pérez", "selected": false}],
            "rows": [
                {"name": "Bruno Silva", "canlink": false, "canunlink": true, "attendanceid": 41,
                 "selectid": "googlemeet-attendance-link-41", "linklabel": "",
                 "unlinktitle": "Undo the match of \"Bruno\" with this student", "kindlabel": "Attended",
                 "hasmatchedby": true, "matchedby": "by e-mail", "meetname": "Bruno", "joined": "4:53 PM",
                 "left": "5:23 PM", "minutes": "31", "last": false},
                {"name": "Visitor", "canlink": true, "canunlink": false, "attendanceid": 42,
                 "selectid": "googlemeet-attendance-link-42", "linklabel": "Student for participant Visitor",
                 "unlinktitle": "", "kindlabel": "Not matched", "hasmatchedby": false, "matchedby": "",
                 "meetname": "Visitor", "joined": "4:55 PM", "left": "5:20 PM", "minutes": "25", "last": true}
            ]
        }
    }
}}
<p class="text-muted">{{#str}} attendance_intro, mod_googlemeet {{/str}}</p>
{{#notices}}
{{{html}}}
{{/notices}}
{{#hasloginpopup}}
<div class="alert alert-info">{{#str}} attendance_login_needed, mod_googlemeet {{/str}}{{{loginpopup}}}</div>
{{/hasloginpopup}}
{{^hassessions}}
{{{nosessionshtml}}}
{{/hassessions}}
{{#hassessions}}
<h3>{{#str}} attendance_sessions, mod_googlemeet {{/str}}</h3>
<div class="table-responsive">
    <table class="generaltable googlemeet-attendance-sessions">
        <thead>
            <tr>
                <th class="header c0" scope="col">{{#str}} attendance_col_session, mod_googlemeet {{/str}}</th>
                <th class="header c1" scope="col">{{#str}} attendance_col_status, mod_googlemeet {{/str}}</th>
                <th class="header c2" scope="col">{{#str}} attendance_col_participants, mod_googlemeet {{/str}}</th>
                <td class="header c3 lastcol"></td>
            </tr>
        </thead>
        <tbody>
            {{#sessions}}
            <tr{{#last}} class="lastrow"{{/last}}>
                <td class="cell c0">{{#selected}}<strong>{{label}}</strong>{{/selected}}{{^selected}}<a href="{{url}}">{{label}}</a>{{/selected}}</td>
                <td class="cell c1">{{statuslabel}}</td>
                <td class="cell c2">{{counts}}</td>
                <td class="cell c3 lastcol"><a href="{{url}}">{{#str}} view {{/str}}</a></td>
            </tr>
            {{/sessions}}
        </tbody>
    </table>
</div>
{{#session}}
{{> mod_googlemeet/attendance_session }}
{{/session}}
{{/hassessions}}
